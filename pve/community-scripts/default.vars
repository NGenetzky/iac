# Defaults for every script on this host, read by My Defaults (mode=mydefaults).
# A var_* set on the command line wins over this file.
# Built on community-scripts.org.

# Container
var_protection="no"
var_verbose="no"

# Network
var_net="dhcp"
var_ipv6_method="none"

# Access
var_ssh="no"

# Features
var_nesting="0"
var_keyctl="0"
var_mknod="0"
var_fuse="no"
var_tun="no"
var_gpu="no"

# Proxy and cache
var_apt_cacher="no"
var_inherit_host_ca="no"
